<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package Name="SShot"
           Manufacturer="SShot"
           Version="!(bind.FileVersion.SShotAppExe)"
           UpgradeCode="5F3DDE94-D3D7-48E6-B51F-9DA409897D54"
           Language="1041"
           Codepage="UTF-8"
           InstallerVersion="500">

    <!--
      Version binds to the published exe's FileVersion instead of being written here, so the
      MSI can never disagree with the binary it ships. The number itself lives in
      Directory.Build.props (<Version>), the same property the exe is built from.
    -->
    <SummaryInformation Description="SShot Setup" Keywords="Installer" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of SShot is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon.ico" SourceFile="$(var.RepoRoot)\assets\icons\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <Feature Id="MainFeature" Title="SShot" Level="1">
      <ComponentRef Id="AppExecutable" />
      <ComponentRef Id="LicenseFile" />
      <ComponentRef Id="ThirdPartyNoticesFile" />
      <ComponentRef Id="Apache20License" />
      <ComponentRef Id="DotnetRuntimeNotices" />
      <ComponentRef Id="SkiaSharpNativeNotices" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="SShot">
        <Directory Id="LICENSESFOLDER" Name="licenses" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="SShot" />
    </StandardDirectory>

    <!--
      A single component for the whole app because the app itself is published as one
      self-contained, single-file exe (PublishSingleFile) - the same artifact the portable
      distribution ships, just placed under Program Files with Start Menu integration and a
      real uninstall entry instead of being a loose file. See build/publish-portable.ps1.
    -->
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="AppExecutable" Guid="*">
        <File Id="SShotAppExe" Source="$(var.PublishDir)\SShot.App.exe" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!--
      The single-file exe bundles the .NET runtime and every NuGet dependency, so the MIT /
      Apache-2.0 notices those licenses require have to be installed alongside it. Sourced from
      the repository rather than the publish output so the repo stays the single source of truth
      for the notices (build/publish-portable.ps1 copies the same files for the portable ZIP).
    -->
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="LicenseFile" Guid="*">
        <File Id="LicenseTxt" Source="$(var.RepoRoot)\LICENSE" KeyPath="yes" />
      </Component>
      <Component Id="ThirdPartyNoticesFile" Guid="*">
        <File Id="ThirdPartyNoticesMd" Source="$(var.RepoRoot)\THIRD-PARTY-NOTICES.md" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="LICENSESFOLDER">
      <Component Id="Apache20License" Guid="*">
        <File Id="Apache20Txt" Source="$(var.RepoRoot)\licenses\Apache-2.0.txt" KeyPath="yes" />
      </Component>
      <Component Id="DotnetRuntimeNotices" Guid="*">
        <File Id="DotnetRuntimeNoticesTxt" Source="$(var.RepoRoot)\licenses\dotnet-runtime-THIRD-PARTY-NOTICES.txt" KeyPath="yes" />
      </Component>
      <Component Id="SkiaSharpNativeNotices" Guid="*">
        <File Id="SkiaSharpNativeNoticesTxt" Source="$(var.RepoRoot)\licenses\skiasharp-native-THIRD-PARTY-NOTICES.txt" KeyPath="yes" />
        <RemoveFolder Id="RemoveLicensesFolder" Directory="LICENSESFOLDER" On="uninstall" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="*">
        <Shortcut Id="StartMenuShortcut"
                  Name="SShot"
                  Description="Windows screenshot tool"
                  Target="[INSTALLFOLDER]SShot.App.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\SShot" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

  </Package>
</Wix>
