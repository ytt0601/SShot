<Project>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Company>SShot</Company>
    <Product>SShot</Product>
    <!-- Single source of the product version: drives AssemblyVersion/FileVersion/
         InformationalVersion for every project, and the MSI's ProductVersion binds to the
         published exe's FileVersion (see installer/wix/Product.wxs) rather than repeating it. -->
    <Version>1.0.0</Version>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

</Project>
