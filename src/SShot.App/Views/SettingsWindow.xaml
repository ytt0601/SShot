<Window x:Class="SShot.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resources="clr-namespace:SShot.App.Resources"
        Title="{x:Static resources:Strings.SettingsWindowTitle}" Height="560" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{x:Static resources:Strings.SaveFolderLabel}" FontWeight="Bold"
                   Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,0,4" />
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding SaveFolder, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
            <Button Grid.Column="1" Content="{x:Static resources:Strings.BrowseButton}" Command="{Binding BrowseFolderCommand}" Padding="8,4" />
        </Grid>

        <CheckBox Grid.Row="2" Content="{x:Static resources:Strings.SaveAsJpegCheckbox}" IsChecked="{Binding SaveAsJpeg}"
                   Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,0,12" />

        <CheckBox Grid.Row="3" Content="{x:Static resources:Strings.AutoStartCheckbox}" IsChecked="{Binding AutoStartEnabled}"
                   Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,0,12" />

        <Grid Grid.Row="4" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static resources:Strings.UiLanguageLabel}" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" SelectedValue="{Binding UiLanguage}" SelectedValuePath="Tag" HorizontalAlignment="Left" Width="160">
                <ComboBoxItem Content="日本語" Tag="ja" />
                <ComboBoxItem Content="English" Tag="en" />
            </ComboBox>
        </Grid>

        <Grid Grid.Row="5" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static resources:Strings.UiLayoutModeLabel}" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding UiLayoutModeOptions}" DisplayMemberPath="DisplayName"
                      SelectedValuePath="Id" SelectedValue="{Binding UiLayoutMode}" HorizontalAlignment="Left" Width="220" />
        </Grid>
        <TextBlock Grid.Row="6" Text="{x:Static resources:Strings.UiLayoutModeHintText}"
                   FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,12" TextWrapping="Wrap" />

        <Grid Grid.Row="7" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static resources:Strings.ColorThemeLabel}" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding ColorThemeOptions}" DisplayMemberPath="DisplayName"
                      SelectedValuePath="Id" SelectedValue="{Binding ColorTheme}" HorizontalAlignment="Left" Width="220" />
        </Grid>

        <TextBlock Grid.Row="8" Text="{x:Static resources:Strings.HotkeysSectionLabel}" FontWeight="Bold"
                   Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,0,4" />

        <Grid Grid.Row="9" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static resources:Strings.CaptureFullScreenButton}" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding FullScreenHotkey, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static resources:Strings.CaptureRegionButton}" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RegionHotkey, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static resources:Strings.CaptureWindowButton}" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding WindowHotkey, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static resources:Strings.CaptureScrollingButton}" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ScrollingHotkey, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" />
        </Grid>

        <TextBlock Grid.Row="10" Text="{x:Static resources:Strings.HotkeyHintText}" VerticalAlignment="Top"
                   FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap" />

        <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{x:Static resources:Strings.SaveButton}" Click="OnSaveClick" Padding="12,4" Margin="0,0,8,0" IsDefault="True" />
            <Button Content="{x:Static resources:Strings.CloseButton}" Click="OnCloseClick" Padding="12,4" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
