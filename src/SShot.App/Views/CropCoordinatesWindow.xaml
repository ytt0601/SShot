<Window x:Class="SShot.App.Views.CropCoordinatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resources="clr-namespace:SShot.App.Resources"
        Title="{x:Static resources:Strings.CropCoordinatesWindowTitle}"
        Height="280" Width="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static resources:Strings.CropXLabel}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" x:Name="XTextBox" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static resources:Strings.CropYLabel}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" x:Name="YTextBox" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static resources:Strings.CropWidthLabel}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" x:Name="WidthTextBox" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static resources:Strings.CropHeightLabel}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" x:Name="HeightTextBox" />
        </Grid>

        <TextBlock Grid.Row="4" x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,0,0,8" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static resources:Strings.OkButton}" Click="OnOkClick" Padding="12,4" Margin="0,0,8,0" IsDefault="True" />
            <Button Content="{x:Static resources:Strings.CancelButton}" Click="OnCancelClick" Padding="12,4" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
