<Window x:Class="SShot.App.Views.RegionSelectionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="Black"
        Cursor="Cross"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Canvas x:Name="RootCanvas">
        <Image x:Name="BackgroundImage" Stretch="Fill" />
        <Path x:Name="DimPath" Fill="#A0000000" />
        <Rectangle x:Name="SelectionBorder"
                   Stroke="DeepSkyBlue"
                   StrokeThickness="1.5"
                   Fill="Transparent"
                   Visibility="Collapsed" />
    </Canvas>
</Window>
