<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="ThemeMarker">Crimson</sys:String>

    <SolidColorBrush x:Key="ThemeAppBackground" Color="#FCF7F7" />
    <SolidColorBrush x:Key="ThemeSurfaceBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThemeSurfaceBorder" Color="#F1DEDD" />
    <SolidColorBrush x:Key="ThemeTextPrimary" Color="#271C1C" />
    <SolidColorBrush x:Key="ThemeTextSecondary" Color="#8A6E6D" />
    <SolidColorBrush x:Key="ThemeAccent" Color="#E4453B" />
    <SolidColorBrush x:Key="ThemeAccentForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThemeChromeBackground" Color="#241616" />
    <SolidColorBrush x:Key="ThemeChromeForeground" Color="#AD8886" />
    <SolidColorBrush x:Key="ThemeChromeActiveBackground" Color="#E4453B" />
    <SolidColorBrush x:Key="ThemeChromeActiveForeground" Color="#FFFFFF" />

</ResourceDictionary>
