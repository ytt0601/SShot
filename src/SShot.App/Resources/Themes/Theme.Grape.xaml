<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="ThemeMarker">Grape</sys:String>

    <SolidColorBrush x:Key="ThemeAppBackground" Color="#FAF8FC" />
    <SolidColorBrush x:Key="ThemeSurfaceBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThemeSurfaceBorder" Color="#E9E1F2" />
    <SolidColorBrush x:Key="ThemeTextPrimary" Color="#241F2B" />
    <SolidColorBrush x:Key="ThemeTextSecondary" Color="#7B7189" />
    <SolidColorBrush x:Key="ThemeAccent" Color="#8B5CF6" />
    <SolidColorBrush x:Key="ThemeAccentForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThemeChromeBackground" Color="#201A2E" />
    <SolidColorBrush x:Key="ThemeChromeForeground" Color="#9587B3" />
    <SolidColorBrush x:Key="ThemeChromeActiveBackground" Color="#8B5CF6" />
    <SolidColorBrush x:Key="ThemeChromeActiveForeground" Color="#FFFFFF" />

</ResourceDictionary>
