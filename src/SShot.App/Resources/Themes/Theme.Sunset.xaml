<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="ThemeMarker">Sunset</sys:String>

    <SolidColorBrush x:Key="ThemeAppBackground" Color="#FCF8F6" />
    <SolidColorBrush x:Key="ThemeSurfaceBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThemeSurfaceBorder" Color="#F1E1DA" />
    <SolidColorBrush x:Key="ThemeTextPrimary" Color="#2B211D" />
    <SolidColorBrush x:Key="ThemeTextSecondary" Color="#8A776E" />
    <SolidColorBrush x:Key="ThemeAccent" Color="#F97362" />
    <SolidColorBrush x:Key="ThemeAccentForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThemeChromeBackground" Color="#2B1B1A" />
    <SolidColorBrush x:Key="ThemeChromeForeground" Color="#B08C87" />
    <SolidColorBrush x:Key="ThemeChromeActiveBackground" Color="#F97362" />
    <SolidColorBrush x:Key="ThemeChromeActiveForeground" Color="#FFFFFF" />

</ResourceDictionary>
