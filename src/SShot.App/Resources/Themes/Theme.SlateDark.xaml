<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="ThemeMarker">SlateDark</sys:String>

    <SolidColorBrush x:Key="ThemeAppBackground" Color="#16181D" />
    <SolidColorBrush x:Key="ThemeSurfaceBackground" Color="#1E2127" />
    <SolidColorBrush x:Key="ThemeSurfaceBorder" Color="#2B2F37" />
    <SolidColorBrush x:Key="ThemeTextPrimary" Color="#E7E9EF" />
    <SolidColorBrush x:Key="ThemeTextSecondary" Color="#8D93A0" />
    <SolidColorBrush x:Key="ThemeAccent" Color="#4FD1C5" />
    <SolidColorBrush x:Key="ThemeAccentForeground" Color="#08211E" />
    <SolidColorBrush x:Key="ThemeChromeBackground" Color="#0E1013" />
    <SolidColorBrush x:Key="ThemeChromeForeground" Color="#6E7480" />
    <SolidColorBrush x:Key="ThemeChromeActiveBackground" Color="#4FD1C5" />
    <SolidColorBrush x:Key="ThemeChromeActiveForeground" Color="#08211E" />

</ResourceDictionary>
