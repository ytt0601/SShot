<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="ThemeMarker">Amber</sys:String>

    <SolidColorBrush x:Key="ThemeAppBackground" Color="#FDFAF4" />
    <SolidColorBrush x:Key="ThemeSurfaceBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThemeSurfaceBorder" Color="#F0E4C8" />
    <SolidColorBrush x:Key="ThemeTextPrimary" Color="#2B2417" />
    <SolidColorBrush x:Key="ThemeTextSecondary" Color="#8C7B57" />
    <SolidColorBrush x:Key="ThemeAccent" Color="#F2A93B" />
    <SolidColorBrush x:Key="ThemeAccentForeground" Color="#2B2417" />
    <SolidColorBrush x:Key="ThemeChromeBackground" Color="#2A2116" />
    <SolidColorBrush x:Key="ThemeChromeForeground" Color="#B3A283" />
    <SolidColorBrush x:Key="ThemeChromeActiveBackground" Color="#F2A93B" />
    <SolidColorBrush x:Key="ThemeChromeActiveForeground" Color="#2B2417" />

</ResourceDictionary>
