<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="ThemeMarker">Rose</sys:String>

    <SolidColorBrush x:Key="ThemeAppBackground" Color="#FDF7FA" />
    <SolidColorBrush x:Key="ThemeSurfaceBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThemeSurfaceBorder" Color="#F3DEE9" />
    <SolidColorBrush x:Key="ThemeTextPrimary" Color="#2A1E25" />
    <SolidColorBrush x:Key="ThemeTextSecondary" Color="#8E6E7D" />
    <SolidColorBrush x:Key="ThemeAccent" Color="#EC6FA0" />
    <SolidColorBrush x:Key="ThemeAccentForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThemeChromeBackground" Color="#2A1720" />
    <SolidColorBrush x:Key="ThemeChromeForeground" Color="#B08696" />
    <SolidColorBrush x:Key="ThemeChromeActiveBackground" Color="#EC6FA0" />
    <SolidColorBrush x:Key="ThemeChromeActiveForeground" Color="#2A1720" />

</ResourceDictionary>
