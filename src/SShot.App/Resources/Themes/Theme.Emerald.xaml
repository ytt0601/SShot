<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="ThemeMarker">Emerald</sys:String>

    <SolidColorBrush x:Key="ThemeAppBackground" Color="#F7FAF9" />
    <SolidColorBrush x:Key="ThemeSurfaceBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThemeSurfaceBorder" Color="#E3EEE9" />
    <SolidColorBrush x:Key="ThemeTextPrimary" Color="#1C2723" />
    <SolidColorBrush x:Key="ThemeTextSecondary" Color="#62766E" />
    <SolidColorBrush x:Key="ThemeAccent" Color="#14B8A6" />
    <SolidColorBrush x:Key="ThemeAccentForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThemeChromeBackground" Color="#142826" />
    <SolidColorBrush x:Key="ThemeChromeForeground" Color="#7FA69C" />
    <SolidColorBrush x:Key="ThemeChromeActiveBackground" Color="#14B8A6" />
    <SolidColorBrush x:Key="ThemeChromeActiveForeground" Color="#06211D" />

</ResourceDictionary>
