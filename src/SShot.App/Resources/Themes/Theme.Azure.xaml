<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="ThemeMarker">Azure</sys:String>

    <SolidColorBrush x:Key="ThemeAppBackground" Color="#FAFAFA" />
    <SolidColorBrush x:Key="ThemeSurfaceBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThemeSurfaceBorder" Color="#E7EAF0" />
    <SolidColorBrush x:Key="ThemeTextPrimary" Color="#20242C" />
    <SolidColorBrush x:Key="ThemeTextSecondary" Color="#6B7280" />
    <SolidColorBrush x:Key="ThemeAccent" Color="#5B8DEF" />
    <SolidColorBrush x:Key="ThemeAccentForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThemeChromeBackground" Color="#1C2333" />
    <SolidColorBrush x:Key="ThemeChromeForeground" Color="#8891A6" />
    <SolidColorBrush x:Key="ThemeChromeActiveBackground" Color="#5B8DEF" />
    <SolidColorBrush x:Key="ThemeChromeActiveForeground" Color="#FFFFFF" />

</ResourceDictionary>
