<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="ThemeMarker">Midnight</sys:String>

    <SolidColorBrush x:Key="ThemeAppBackground" Color="#14151C" />
    <SolidColorBrush x:Key="ThemeSurfaceBackground" Color="#1C1E27" />
    <SolidColorBrush x:Key="ThemeSurfaceBorder" Color="#2A2C38" />
    <SolidColorBrush x:Key="ThemeTextPrimary" Color="#E7E8F0" />
    <SolidColorBrush x:Key="ThemeTextSecondary" Color="#8A8CA0" />
    <SolidColorBrush x:Key="ThemeAccent" Color="#7C8CF5" />
    <SolidColorBrush x:Key="ThemeAccentForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThemeChromeBackground" Color="#0D0E14" />
    <SolidColorBrush x:Key="ThemeChromeForeground" Color="#6A6C82" />
    <SolidColorBrush x:Key="ThemeChromeActiveBackground" Color="#7C8CF5" />
    <SolidColorBrush x:Key="ThemeChromeActiveForeground" Color="#FFFFFF" />

</ResourceDictionary>
