<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="ThemeMarker">Ocean</sys:String>

    <SolidColorBrush x:Key="ThemeAppBackground" Color="#F5FAFC" />
    <SolidColorBrush x:Key="ThemeSurfaceBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThemeSurfaceBorder" Color="#DCEBF1" />
    <SolidColorBrush x:Key="ThemeTextPrimary" Color="#1B262B" />
    <SolidColorBrush x:Key="ThemeTextSecondary" Color="#5E7B87" />
    <SolidColorBrush x:Key="ThemeAccent" Color="#2FA8D5" />
    <SolidColorBrush x:Key="ThemeAccentForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThemeChromeBackground" Color="#132630" />
    <SolidColorBrush x:Key="ThemeChromeForeground" Color="#7FA6B8" />
    <SolidColorBrush x:Key="ThemeChromeActiveBackground" Color="#2FA8D5" />
    <SolidColorBrush x:Key="ThemeChromeActiveForeground" Color="#06222C" />

</ResourceDictionary>
